{erl_opts, [debug_info, warnings_as_errors]}.

%% For local development, link a checkout of peace at `_checkouts/peace'.
{deps, [{peace, {git, "https://github.com/jessestimpson/peace.git", {branch, "main"}}}]}.

{shell, [
    {apps, [redwall]}
]}.

{profiles, [
    %% The benchmark, bench/redwall_bench.erl. Run it with `bench/run.sh'.
    {bench, [{extra_src_dirs, ["bench"]}]},
    %% Deterministic simulation testing. Run it with `rebar3 as dst eunit'.
    %% Everything related to eta is confined to this profile:
    %%   - the DST define, which enables include/redwall_eta.hrl,
    %%   - the eta dependency, and
    %%   - dst/, which contains the harness and its test suite.
    %% For local development, link a checkout of eta at `_checkouts/eta'.
    {dst, [
        % rebar.lock holds the dependencies of the default profile only, so
        % the version of eta is fixed here, with a commit.
        {deps, [
            {eta,
                {git, "https://github.com/jessestimpson/eta.git",
                    {ref, "41bf3eb1a232aafccff873c8763860294900d746"}}}
        ]},
        {erl_opts, [{d, 'DST'}]},
        %% peace is compiled with DST too, so that a peace cluster runs
        %% under the scheduler of eta as the coordinated state.
        {overrides, [{add, peace, [{erl_opts, [{d, 'DST'}]}]}]},
        {extra_src_dirs, ["dst"]},
        {eunit_tests, [{module, redwall_dst_tests}]},
        {eunit_opts, [verbose]},
        {dialyzer, [{plt_extra_apps, [eunit, eta]}]}
    ]}
]}.
